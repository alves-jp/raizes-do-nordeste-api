# ------------------------------------------------------------
# Raízes do Nordeste API — variáveis de ambiente
# Copie este arquivo para .env:   cp .env.example .env
# Todos os valores abaixo têm padrão seguro para desenvolvimento;
# a API sobe mesmo sem o .env, mas troque JWT_SECRET fora do ambiente local.
# ------------------------------------------------------------

# Porta HTTP da API
PORT=3000

# Caminho do arquivo SQLite (criado automaticamente)
DATABASE_PATH=data/raizes.sqlite

# Aplica as migrations automaticamente ao iniciar a API (true/false)
DB_MIGRATIONS_RUN=true

# Segredo usado para assinar o JWT (use 32+ caracteres aleatórios)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Validade do token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Gateway de pagamento simulado (mock)
# Latência artificial de cada chamada ao gateway, em ms
PAYMENT_GATEWAY_LATENCY_MS=150
# Tempo máximo de espera por resposta do gateway, em ms
PAYMENT_GATEWAY_TIMEOUT_MS=2000
# Novas tentativas automáticas em falha transitória do gateway
PAYMENT_GATEWAY_RETRIES=1

# Origens liberadas no CORS (separadas por vírgula; * libera todas)
CORS_ORIGINS=*

# Tentativas de login com erro antes de bloquear temporariamente o e-mail
LOGIN_MAX_TENTATIVAS=5
# Duração do bloqueio, em minutos
LOGIN_BLOQUEIO_MINUTOS=15
