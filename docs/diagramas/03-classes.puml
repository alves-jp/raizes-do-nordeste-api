@startuml 03-classes
' Diagrama de Classes — visão de domínio (entidades, enums e regras)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #5A3E2B
  ArrowColor #5A3E2B
  HeaderBackgroundColor #F3DFC1
}
skinparam package {
  BorderColor #B5651D
  FontColor #5A3E2B
}
hide empty members

package "Rede e catálogo" {
  class Unidade {
    id : int
    nome : string
    cidade : string
    uf : string
    tipo : TipoUnidade
    ativa : boolean
  }
  class Produto {
    id : int
    nome : string
    categoria : CategoriaProduto
    sazonal : boolean
    mesInicio : int
    mesFim : int
    ativo : boolean
    + estaEmTemporada(data) : boolean
  }
  class ItemCardapio {
    precoCentavos : int
    disponivel : boolean
  }
  class Estoque {
    quantidade : int
    estoqueMinimo : int
    + reservar(qtd)
    + devolver(qtd)
  }
  class MovimentacaoEstoque {
    tipo : TipoMovimentacaoEstoque
    quantidade : int
    saldoApos : int
    motivo : string
  }
}

package "Pessoas e LGPD" {
  class Usuario {
    id : int
    nome : string
    email : string
    senhaHash : string
    telefone : string
    perfil : Perfil
    ativo : boolean
    anonimizadoEm : Date
    + anonimizar()
  }
  class Consentimento {
    finalidade : FinalidadeConsentimento
    concedido : boolean
    versaoTermo : string
    origem : string
    registradoEm : Date
  }
}

package "Pedidos e pagamento" {
  class Pedido {
    id : int
    canalPedido : CanalPedido
    status : StatusPedido
    formaPagamento : FormaPagamento
    subtotalCentavos : int
    descontoCampanhaCentavos : int
    descontoPontosCentavos : int
    totalCentavos : int
    pontosResgatados : int
    chaveIdempotencia : string
    + atualizarStatus(novo, perfil)
    + cancelar(motivo, perfil)
  }
  class ItemPedido {
    nomeProduto : string
    quantidade : int
    precoUnitarioCentavos : int
    subtotalCentavos : int
  }
  class Pagamento {
    valorCentavos : int
    forma : FormaPagamento
    status : StatusPagamento
    transacaoExternaId : string
    codigoRetorno : string
    respostaGateway : JSON
    chaveIdempotencia : string
  }
  interface GatewayDePagamento <<porta>> {
    + cobrar(solicitacao) : RespostaDeCobranca
    + estornar(transacaoId, valor) : RespostaDeEstorno
  }
  class GatewayDePagamentoMock <<adaptador>>
}

package "Fidelidade e campanhas" {
  class TransacaoFidelidade {
    tipo : TipoTransacaoFidelidade
    pontos : int
    descricao : string
  }
  class Campanha {
    codigo : string
    percentualDesconto : int
    inicio : Date
    fim : Date
    canalPedido : CanalPedido
    valorMinimoCentavos : int
    + calcularDesconto(contexto) : int
  }
}

class LogAuditoria {
  acao : AcaoAuditoria
  entidade : string
  entidadeId : int
  perfil : Perfil
  detalhes : JSON
  requestId : string
}

enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}
enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_RECUSADO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}
enum Perfil {
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  ADMIN
  TOTEM
}

Unidade "1" *-- "0..*" ItemCardapio
Produto "1" -- "0..*" ItemCardapio
Unidade "1" *-- "0..*" Estoque
Produto "1" -- "0..*" Estoque
Estoque "1" -- "0..*" MovimentacaoEstoque : histórico >
Unidade "1" o-- "0..*" Usuario : funcionários >
Usuario "1" *-- "0..*" Consentimento
Unidade "1" -- "0..*" Pedido
Usuario "0..1" -- "0..*" Pedido : cliente >
Pedido "1" *-- "1..*" ItemPedido
ItemPedido "0..*" --> "1" Produto
Pedido "1" -- "0..*" Pagamento : tentativas >
Pedido "0..*" --> "0..1" Campanha
Usuario "1" -- "0..*" TransacaoFidelidade : extrato >
Pedido "0..1" -- "0..*" TransacaoFidelidade
Pagamento ..> GatewayDePagamento : solicitado via >
GatewayDePagamentoMock ..|> GatewayDePagamento
Pedido ..> CanalPedido
Pedido ..> StatusPedido
Usuario ..> Perfil
@enduml
