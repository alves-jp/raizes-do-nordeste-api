@startuml 02-der
' DER — banco SQLite da API Raízes do Nordeste (reflete a migration 1792200000000-EsquemaInicial)
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #5A3E2B
  ArrowColor #5A3E2B
  HeaderBackgroundColor #F3DFC1
}

entity "unidades" as unidades {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(120)
  * cidade : VARCHAR(80)
  * uf : VARCHAR(2)
  * tipo : PROPRIA | FRANQUIA
  horario_funcionamento : VARCHAR(20)
  * ativa : BOOLEAN
  * criado_em : DATETIME
}

entity "usuarios" as usuarios {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(120)
  * email : VARCHAR(160) <<UNIQUE>>
  * senha_hash : VARCHAR(100)  (bcrypt)
  telefone : VARCHAR(20)
  * perfil : CLIENTE | ATENDENTE | COZINHA | GERENTE | ADMIN | TOTEM
  unidade_id : INTEGER <<FK>>
  * ativo : BOOLEAN
  versao_termos_aceita : VARCHAR(10)
  termos_aceitos_em : DATETIME
  anonimizado_em : DATETIME
  * criado_em / atualizado_em : DATETIME
}

entity "consentimentos" as consentimentos {
  * id : INTEGER <<PK>>
  --
  * usuario_id : INTEGER <<FK>>
  * finalidade : FIDELIDADE | MARKETING
  * concedido : BOOLEAN
  * versao_termo : VARCHAR(10)
  * origem : VARCHAR(40)
  * registrado_em : DATETIME
}

entity "produtos" as produtos {
  * id : INTEGER <<PK>>
  --
  * nome : VARCHAR(120) <<UNIQUE>>
  descricao : VARCHAR(400)
  * categoria : TAPIOCAS | CUSCUZ | PRATOS | ...
  * sazonal : BOOLEAN
  mes_inicio / mes_fim : INTEGER (1–12)
  * ativo : BOOLEAN
  <<CHECK sazonal = 0 OR meses entre 1 e 12>>
}

entity "itens_cardapio" as cardapio {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  * produto_id : INTEGER <<FK>>
  * preco_centavos : INTEGER  <<CHECK > 0>>
  * disponivel : BOOLEAN
  <<UNIQUE (unidade_id, produto_id)>>
}

entity "estoques" as estoques {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  * produto_id : INTEGER <<FK>>
  * quantidade : INTEGER  <<CHECK >= 0>>
  * estoque_minimo : INTEGER
  <<UNIQUE (unidade_id, produto_id)>>
}

entity "movimentacoes_estoque" as movs {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  * produto_id : INTEGER <<FK>>
  * tipo : ENTRADA | SAIDA | RESERVA_PEDIDO | ESTORNO_PEDIDO
  * quantidade : INTEGER  <<CHECK > 0>>
  * saldo_apos : INTEGER
  motivo : VARCHAR(200)
  pedido_id : INTEGER <<FK>>
  usuario_id : INTEGER <<FK>>
}

entity "campanhas" as campanhas {
  * id : INTEGER <<PK>>
  --
  * codigo : VARCHAR(30) <<UNIQUE>>
  * descricao : VARCHAR(200)
  * percentual_desconto : INTEGER <<CHECK 1–50>>
  * inicio / fim : DATETIME <<CHECK fim > inicio>>
  unidade_id : INTEGER <<FK>>
  canal_pedido : APP | TOTEM | BALCAO | PICKUP | WEB
  * valor_minimo_centavos : INTEGER
  * ativa : BOOLEAN
}

entity "pedidos" as pedidos {
  * id : INTEGER <<PK>>
  --
  * unidade_id : INTEGER <<FK>>
  cliente_id : INTEGER <<FK>>
  * criado_por_id : INTEGER <<FK>>
  * canal_pedido : APP | TOTEM | BALCAO | PICKUP | WEB
  * status : AGUARDANDO_PAGAMENTO | PAGAMENTO_RECUSADO | PAGO
           | EM_PREPARO | PRONTO | ENTREGUE | CANCELADO
  * forma_pagamento : PIX | CARTAO_CREDITO | CARTAO_DEBITO
  * subtotal_centavos, desconto_campanha_centavos,
    desconto_pontos_centavos, total_centavos : INTEGER
  campanha_id : INTEGER <<FK>>
  * pontos_resgatados : INTEGER
  observacao / motivo_cancelamento : VARCHAR(200)
  chave_idempotencia : VARCHAR(80)
  <<UNIQUE (criado_por_id, chave_idempotencia)>>
  <<CHECK total = subtotal − descontos>>
}

entity "itens_pedido" as itens {
  * id : INTEGER <<PK>>
  --
  * pedido_id : INTEGER <<FK>>
  * produto_id : INTEGER <<FK>>
  * nome_produto : VARCHAR(120)  (snapshot)
  * quantidade : INTEGER <<CHECK > 0>>
  * preco_unitario_centavos : INTEGER  (snapshot)
  * subtotal_centavos : INTEGER
}

entity "pagamentos" as pagamentos {
  * id : INTEGER <<PK>>
  --
  * pedido_id : INTEGER <<FK>>
  * valor_centavos : INTEGER
  * forma : PIX | CARTAO_CREDITO | CARTAO_DEBITO
  * status : PENDENTE | APROVADO | RECUSADO
           | FALHA_COMUNICACAO | ESTORNADO
  transacao_externa_id : VARCHAR(80)
  codigo_retorno / mensagem_retorno
  resposta_gateway : TEXT (JSON)
  chave_idempotencia : VARCHAR(80) <<UNIQUE>>
}

entity "transacoes_fidelidade" as fidelidade {
  * id : INTEGER <<PK>>
  --
  * cliente_id : INTEGER <<FK>>
  pedido_id : INTEGER <<FK>>
  * tipo : ACUMULO | RESGATE | ESTORNO_ACUMULO | ESTORNO_RESGATE
  * pontos : INTEGER (+ crédito / − débito)
  * descricao : VARCHAR(160)
}

entity "logs_auditoria" as auditoria {
  * id : INTEGER <<PK>>
  --
  * acao : PEDIDO_CRIADO | PAGAMENTO_APROVADO | ...
  * entidade : VARCHAR(40)
  entidade_id, usuario_id, unidade_id : INTEGER
  perfil : VARCHAR
  detalhes : TEXT (JSON, sem dados pessoais em claro)
  ip : VARCHAR(45)
  request_id : VARCHAR(64)
  * criado_em : DATETIME
  (sem FK: trilha imutável)
}

unidades ||--o{ usuarios : "lota\n(funcionários/totens)"
unidades ||--o{ cardapio
produtos ||--o{ cardapio
unidades ||--o{ estoques
produtos ||--o{ estoques
unidades ||--o{ movs
produtos ||--o{ movs
unidades |o--o{ campanhas
usuarios ||--o{ consentimentos
unidades ||--o{ pedidos
usuarios |o--o{ pedidos : "cliente"
usuarios ||--o{ pedidos : "criado por"
campanhas |o--o{ pedidos
pedidos ||--|{ itens
produtos ||--o{ itens
pedidos ||--o{ pagamentos
pedidos |o--o{ movs
usuarios ||--o{ fidelidade
pedidos |o--o{ fidelidade
@enduml
