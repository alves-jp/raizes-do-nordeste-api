{
  "name": "raizes-do-nordeste-api",
  "version": "1.0.0",
  "description": "API Back-end da Rede Raízes do Nordeste — pedidos multicanal, estoque por unidade, pagamento mock, fidelização e LGPD (Projeto Multidisciplinar UNINTER — Trilha Back-End)",
  "author": "João Pedro Alves e Silva",
  "repository": {
    "type": "git",
    "url": "https://github.com/alves-jp/raizes-do-nordeste-api.git"
  },
  "homepage": "https://alves-jp.github.io/raizes-do-nordeste-api/swagger/",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "setup": "ts-node src/infrastructure/database/seeds/executar-seed.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database/data-source.ts",
    "db:reset": "node scripts/resetar-banco.js && npm run setup",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:e2e": "jest --runInBand test/e2e",
    "test:postman": "newman run postman/raizes-do-nordeste.postman_collection.json -e postman/local.postman_environment.json",
    "openapi:export": "ts-node scripts/exportar-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.15.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "newman": "^6.2.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/configurar-ambiente.ts"
    ]
  }
}
